const isFill = name in FILL;
const body = isFill ? FILL[name as keyof typeof FILL] : STROKE[name as keyof typeof STROKE];
---

{isFill ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={body} />
) : (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={body}
  />
)}
