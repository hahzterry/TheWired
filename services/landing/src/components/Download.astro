---
/**
 * Downloads. The latest release is read from GitHub at build time so the page
 * works without JavaScript; in the browser the script re-reads it (to catch a
 * release published after this build), picks the visitor's platform, and
 * points the hero's button at the right build. Phones get the full list:
 * The Wired is a desktop app.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import accentGuy from '../assets/characters/accent-guy.png';
import { RELEASES_URL, REQUIREMENTS } from '../data/site';
import { fallbackRelease, fetchLatestRelease, type Release } from '../lib/platforms';

let release: Release = fallbackRelease();
try {
  release = await fetchLatestRelease();
} catch (err) {
  console.warn(`[landing] latest release unavailable at build time, linking to the releases page: ${String(err)}`);
}

const osIcon = { macOS: 'apple', Windows: 'windows', Linux: 'linux' } as const;
---

<section id="download" class="section overflow-hidden border-t border-border bg-panel">
  <div class="backlight left-1/2 top-1/3 h-[480px] w-[720px] -translate-x-1/2 opacity-30" style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-deep) 40%, transparent), transparent 70%);" />

  <div class="container relative">
    <div class="reveal max-w-xl">
      <p class="eyebrow">Download</p>
      <h2 class="mt-5 text-title font-semibold">Get The Wired.</h2>
      <p class="mt-5 text-lede text-body">Free and open source. Updates install themselves.</p>
    </div>

    <div class="mt-14 md:mt-20">
      <div class="reveal card relative p-6 sm:p-8">
        <!-- he sits on the card's edge -->
        <Picture
          src={accentGuy}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[200, 400]}
          sizes="200px"
          alt=""
          loading="lazy"
          class="pointer-events-none absolute -top-[150px] right-8 hidden w-[210px] drop-shadow-[0_20px_30px_#000000aa] md:block"
        />

        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-mono text-[0.78rem] text-muted">
              Desktop · <span data-release-version>{release.version ? `v${release.version}` : 'latest release'}</span>
            </p>
            <p class="mt-1 text-2xl font-semibold text-heading" data-primary-title>Pick your platform</p>
            <p class="mt-1 text-sm text-muted" data-primary-detail>{REQUIREMENTS}</p>
          </div>
          <a href={RELEASES_URL} class="btn btn-primary w-full sm:w-auto" data-primary-link>
            <Icon name="download" size={18} strokeWidth={2.4} />
            <span data-primary-label>All downloads</span>
          </a>
        </div>

        <ul class="mt-8 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3" aria-label="All builds">
          {release.builds.map((b) => (
            <li>
              <a
                href={b.url}
                class="build group flex items-center gap-4 rounded-xl border border-border bg-panel px-4 py-3.5 transition-colors hover:border-border-strong hover:bg-surface"
                data-build={b.id}
              >
                <span class="text-body group-hover:text-heading"><Icon name={osIcon[b.os]} size={20} /></span>
                <span class="min-w-0 flex-1">
                  <span class="block font-medium text-heading">
                    {b.os} <span class="font-normal text-muted">· {b.detail}</span>
                  </span>
                  <span class="block truncate font-mono text-[0.7rem] text-muted" data-build-file>{b.file ?? 'GitHub releases'}</span>
                </span>
                <Icon name="download" size={16} class="text-muted group-hover:text-primary" />
              </a>
            </li>
          ))}
          <li>
            <a href={RELEASES_URL} class="group flex h-full items-center gap-4 rounded-xl border border-dashed border-border px-4 py-3.5 text-body transition-colors hover:border-border-strong hover:text-heading">
              <Icon name="code" size={20} />
              <span class="flex-1">Release notes & checksums</span>
              <Icon name="arrow-up-right" size={16} />
            </a>
          </li>
        </ul>

        <p class="mt-6 font-mono text-[0.75rem] text-muted">{REQUIREMENTS}</p>
      </div>

    </div>
  </div>

  <script type="application/json" id="release-data" set:html={JSON.stringify(release)} />
</section>

<style>
  .build[data-detected] {
    border-color: var(--color-primary-deep);
    background: color-mix(in srgb, var(--color-primary-deep) 14%, transparent);
  }
</style>

<script>
  import { RELEASES_URL } from '../data/site';
  import { detectDevice, fetchLatestRelease, primaryBuildFor, type BuildId, type Device, type Release } from '../lib/platforms';

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const setText = (sel: string, text: string) => { const el = $(sel); if (el) el.textContent = text; };

  const device: Device = detectDevice();
  let preferred: BuildId | null = primaryBuildFor(device);

  function apply(release: Release) {
    const version = release.version ? `v${release.version}` : 'latest release';
    document.querySelectorAll('[data-release-version]').forEach((el) => (el.textContent = version));

    for (const b of release.builds) {
      const a = $<HTMLAnchorElement>(`[data-build="${b.id}"]`);
      if (!a) continue;
      a.href = b.url;
      const file = a.querySelector('[data-build-file]');
      if (file) file.textContent = b.file ?? 'GitHub releases';
      a.toggleAttribute('data-detected', b.id === preferred);
    }

    const heroCta = $<HTMLAnchorElement>('[data-hero-cta]');
    const heroMeta = $('[data-hero-meta]');

    // A phone can't run the desktop app: send the button to the full list.
    if (device === 'ios' || device === 'android') {
      if (heroCta) heroCta.href = '#download';
      setText('[data-hero-cta-label]', 'Get it for your computer');
      setText('[data-hero-meta]', 'For macOS, Windows and Linux.');
      return;
    }

    const build = release.builds.find((b) => b.id === preferred);
    if (!build) return;
    const label = `Download for ${build.os}`;
    const detail = `${build.detail} · ${version}`;

    const primary = $<HTMLAnchorElement>('[data-primary-link]');
    if (primary) primary.href = build.url;
    setText('[data-primary-label]', label);
    setText('[data-primary-title]', `${build.os} · ${build.detail}`);
    setText('[data-primary-detail]', build.file ?? 'From the latest GitHub release');

    if (heroCta) heroCta.href = build.url === RELEASES_URL ? '#download' : build.url;
    setText('[data-hero-cta-label]', label);
    if (heroMeta) {
      heroMeta.innerHTML = '';
      heroMeta.append(`${detail}. `);
      const a = Object.assign(document.createElement('a'), { href: '#download', className: 'text-link', textContent: 'Other platforms' });
      heroMeta.append(a);
    }
  }

  const dataEl = document.getElementById('release-data');
  let current: Release | null = null;
  try {
    current = JSON.parse(dataEl?.textContent ?? 'null') as Release;
  } catch {
    current = null;
  }
  if (current) apply(current);

  // Intel Macs: Chromium can tell us the architecture; Safari and Firefox can't,
  // and the Apple Silicon build stays the default there.
  const uaData = (navigator as Navigator & {
    userAgentData?: { getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }> };
  }).userAgentData;
  if (device === 'macos' && uaData?.getHighEntropyValues) {
    uaData.getHighEntropyValues(['architecture']).then(({ architecture }) => {
      if (architecture === 'x86') {
        preferred = 'macos-intel';
        if (current) apply(current);
      }
    }).catch(() => {});
  }

  // Pick up a release published after this page was built.
  fetchLatestRelease().then((latest) => {
    if (latest.version && latest.version !== current?.version) {
      current = latest;
      apply(latest);
    }
  }).catch(() => {});
</script>
