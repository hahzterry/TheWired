---
import { Picture } from 'astro:assets';
import cyberGirl from '../assets/characters/cyber-girl.png';

const principles = [
  {
    title: 'Your key is your account',
    body: 'No email, no phone number. Your identity is a key pair kept in your OS keychain, and every Nostr app recognizes it.',
  },
  {
    title: 'Relays you choose',
    body: 'Posts are copied across relays, so no single server holds your life. Change apps or relays and your people come with you.',
  },
  {
    title: 'No ads, no feed games',
    body: 'Your feed is the people you follow, not an engagement algorithm. Nothing about you is sold or boosted.',
  },
  {
    title: 'Open source, top to bottom',
    body: 'App, relay, backend and gateway are MIT-licensed. Read the code, fork it, or run the whole stack yourself.',
  },
];
---

<section id="principles" class="section overflow-hidden border-t border-border bg-panel">
  <div class="container grid grid-cols-1 gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal relative">
      <p class="eyebrow">Principles</p>
      <h2 class="mt-5 text-title font-semibold">Own your corner of the internet.</h2>
      <p class="mt-5 max-w-md text-lede text-body">
        The Wired runs on <a class="text-link" href="https://nostr.com/">Nostr</a>, an open protocol where people hold
        their own keys. That one choice changes who's in charge.
      </p>

      <div class="relative mt-10 hidden max-w-[19rem] lg:block">
        <div class="backlight inset-[14%] opacity-60" style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-deep) 33%, transparent), color-mix(in srgb, var(--color-accent-deep) 19%, transparent) 45%, transparent 68%);" />
        <Picture
          src={cyberGirl}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[320, 480, 640]}
          sizes="19rem"
          alt=""
          loading="lazy"
          class="drift relative w-full drop-shadow-[0_24px_48px_#000000aa]"
        />
      </div>
    </div>

    <div class="flex flex-col justify-center">
      <ol class="grid grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2">
        {principles.map((p, i) => (
          <li class="reveal border-t border-border-strong pt-6">
            <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-xl font-semibold">{p.title}</h3>
            <p class="mt-3 text-body">{p.body}</p>
          </li>
        ))}
      </ol>

      <p class="reveal mt-12 rounded-2xl border border-border bg-card p-5 text-[0.95rem] text-body">
        <span class="font-medium text-heading">A straight answer on moderation:</span> we moderate what our own relay and
        spaces serve, under published <a class="text-link" href="/community-guidelines">community guidelines</a>. That keeps
        spaces healthy. What no one can do is take your key, or the people who follow it, away from you.
      </p>
    </div>
  </div>
</section>
