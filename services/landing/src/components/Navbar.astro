---
import Icon from './Icon.astro';
import { GITHUB_URL } from '../data/site';

const links = [
  { href: '#inside', label: 'Inside' },
  { href: '#features', label: 'Features' },
  { href: '#principles', label: 'Principles' },
  { href: '#faq', label: 'FAQ' },
];
---

<header id="navbar" class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-300 border-b border-transparent">
  <nav class="container flex h-16 items-center justify-between gap-6" aria-label="Main">
    <a href="/" class="group flex items-center gap-3" aria-label="The Wired, home">
      <img src="/logo-64.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg transition-transform duration-300 group-hover:rotate-[-8deg]" />
      <span class="wordmark text-[0.95rem]">The Wired</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="rounded-full px-3 py-2 text-sm text-body transition-colors hover:text-heading">{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-2 md:flex">
      <a href={GITHUB_URL} class="flex h-9 w-9 items-center justify-center rounded-full text-body transition-colors hover:text-heading" aria-label="The Wired on GitHub">
        <Icon name="github" size={18} />
      </a>
      <a href="#download" class="btn btn-primary btn-sm">
        Download
        <Icon name="download" size={15} strokeWidth={2.4} />
      </a>
    </div>

    <button
      id="menu-button"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full text-heading md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <Icon name="menu" size={22} class="menu-open" />
      <Icon name="x" size={22} class="menu-close hidden" />
    </button>
  </nav>

  <div id="mobile-menu" class="container hidden pb-5 md:hidden">
    <ul class="card flex flex-col gap-1 p-2">
      {links.map((l) => (
        <li><a href={l.href} class="block rounded-xl px-4 py-3 text-heading hover:bg-surface">{l.label}</a></li>
      ))}
      <li>
        <a href={GITHUB_URL} class="flex items-center gap-2 rounded-xl px-4 py-3 text-heading hover:bg-surface">
          <Icon name="github" size={16} /> GitHub
        </a>
      </li>
      <li class="p-2"><a href="#download" class="btn btn-primary w-full">Download</a></li>
    </ul>
  </div>
</header>

<style>
  #navbar[data-scrolled] {
    background-color: #0c0910d9;
    border-bottom-color: var(--color-border);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const onScroll = () => navbar?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    button?.querySelector('.menu-open')?.classList.toggle('hidden', open);
    button?.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    if (open) navbar?.setAttribute('data-scrolled', '');
    else onScroll();
  };
  button?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      setOpen(false);
      button?.focus();
    }
  });
</script>
