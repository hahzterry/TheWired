---
import Icon from './Icon.astro';

const small = [
  {
    icon: 'lock',
    title: 'Encrypted where it counts',
    body: 'Direct and group messages (NIP-17), calls and voice channels are end-to-end encrypted, and spaces can be too. The relays in between only see ciphertext.',
  },
  {
    icon: 'zap',
    title: 'Tip in sats',
    body: 'Connect any Nostr Wallet Connect wallet and zap posts, tracks and people over Lightning.',
  },
  {
    icon: 'file-text',
    title: 'Articles, polls, quotes',
    body: 'Long-form posts with a real editor, polls, reposts and quotes: the whole Nostr toolkit, not a cut-down one.',
  },
  {
    icon: 'cpu',
    title: 'An assistant that asks first',
    body: 'Optional AI on a local model (Ollama, LM Studio, or one the app runs for you) or your own key. It drafts; nothing is posted until you approve it.',
  },
] as const;

const speakers = [
  { name: 'kxra', hue: '#A9BC9C', talking: true },
  { name: 'sable', hue: '#C39BB8', talking: false },
  { name: 'low tide', hue: '#7FA3B8', talking: false },
  { name: 'juno', hue: '#E8C27A', talking: false },
];
---

<section id="features" class="section border-t border-border">
  <div class="container">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Features</p>
      <h2 class="mt-5 text-title font-semibold">Built for communities, not for ad metrics.</h2>
      <p class="mt-5 text-lede text-body">
        What you'd expect from a modern chat app, plus the things only an open network can do.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6">
      <!-- voice & video: the wide cell -->
      <article class="reveal card overflow-hidden p-7 md:col-span-2 lg:col-span-4">
        <div class="grid h-full gap-8 sm:grid-cols-[1fr_15rem] sm:items-center">
          <div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-primary"><Icon name="video" /></span>
            <h3 class="mt-5 text-2xl font-semibold">Voice & video, built in</h3>
            <p class="mt-3 text-body">
              Drop into a voice channel or call a friend. Video, screen sharing and a stage that fits two people or twenty.
            </p>
          </div>
          <!-- a voice channel, drawn -->
          <div class="rounded-2xl border border-border bg-panel p-4" aria-hidden="true">
            <p class="flex items-center gap-2 font-mono text-[0.7rem] text-muted">
              <Icon name="mic" size={12} /> listening-room
            </p>
            <ul class="mt-3 grid grid-cols-2 gap-2">
              {speakers.map((s) => (
                <li class="flex flex-col items-center gap-2 rounded-xl bg-card py-3">
                  <span
                    class:list={['h-10 w-10 rounded-full', s.talking && 'ring-2 ring-primary ring-offset-2 ring-offset-card']}
                    style={`background: radial-gradient(circle at 35% 30%, ${s.hue}, #241C2D 75%);`}
                  />
                  <span class="font-mono text-[0.65rem] text-body">{s.name}</span>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex h-6 items-center justify-center gap-[3px]">
              {Array.from({ length: 18 }, (_, i) => (
                <span
                  class="w-[3px] origin-center rounded-full bg-primary/70"
                  style={`height: ${8 + ((i * 7) % 16)}px; animation: speak ${0.9 + (i % 5) * 0.17}s ease-in-out ${-(i * 0.13)}s infinite;`}
                />
              ))}
            </div>
          </div>
        </div>
      </article>

      <article class="reveal card p-7 lg:col-span-2">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-primary"><Icon name={small[0].icon} /></span>
        <h3 class="mt-5 text-xl font-semibold">{small[0].title}</h3>
        <p class="mt-3 text-[0.95rem] text-body">{small[0].body}</p>
      </article>

      {small.slice(1).map((f) => (
        <article class="reveal card p-7 lg:col-span-2">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-primary"><Icon name={f.icon} /></span>
          <h3 class="mt-5 text-xl font-semibold">{f.title}</h3>
          <p class="mt-3 text-[0.95rem] text-body">{f.body}</p>
        </article>
      ))}

      <!-- self-hosting -->
      <article class="reveal card p-7 lg:col-span-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-primary"><Icon name="server" /></span>
        <h3 class="mt-5 text-xl font-semibold">Host a space yourself</h3>
        <p class="mt-3 text-[0.95rem] text-body">
          Run a space from your own computer with the built-in relay, shared through a secure tunnel, or point it at any relay you trust.
        </p>
        <pre class="mt-5 overflow-x-auto rounded-xl border border-border bg-panel p-4 font-mono text-[0.75rem] leading-relaxed text-muted" aria-hidden="true"><span class="text-primary">●</span> relay      <span class="text-body">running</span> · sqlite
<span class="text-primary">●</span> tunnel     <span class="text-body">wss://your-space.example</span>
<span class="text-accent">●</span> members    <span class="text-body">read & post</span> · NIP-29 + NIP-42</pre>
      </article>

      <!-- keys -->
      <article class="reveal card p-7 lg:col-span-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-surface text-primary"><Icon name="key" /></span>
        <h3 class="mt-5 text-xl font-semibold">Bring the key you already have</h3>
        <p class="mt-3 text-[0.95rem] text-body">
          Keep your key in your OS keychain, import one you already use, or approve each signature from a remote signer (NIP-46). Switch accounts in a click.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          <li class="tag">OS keychain</li>
          <li class="tag">nsec import</li>
          <li class="tag">NIP-46 bunker</li>
          <li class="tag">multi-account</li>
        </ul>
      </article>
    </div>
  </div>
</section>
