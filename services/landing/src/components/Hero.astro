---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Wires from './Wires.astro';
import heroGirl from '../assets/characters/hero-girl.png';
import { GITHUB_URL } from '../data/site';

const proof = [
  'Free & open source (MIT)',
  'No email, no phone number',
  'macOS · Windows · Linux',
  'iPhone & Android via soot',
];
---

<section id="top" class="relative isolate overflow-hidden pt-28 pb-14 sm:pt-32 lg:pt-36 lg:pb-20">
  <!-- backdrop -->
  <div class="hero-grid -z-10" />
  <div class="absolute inset-x-0 top-0 -z-10 h-[640px]">
    <Wires class="h-full w-full" />
  </div>
  <div class="backlight -z-10 left-[-10%] top-[10%] h-[420px] w-[520px] opacity-40" style="background: radial-gradient(circle, #60706055, transparent 70%);" />

  <div class="container grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.18fr_0.82fr] lg:gap-4">
    <!-- copy -->
    <div class="text-center lg:text-left">
      <p class="rise tag mx-auto lg:mx-0">
        <span class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_10px_#A9BC9C]" />
        Open source · built on Nostr
      </p>

      <h1 class="rise rise-1 mt-6 text-display font-semibold">
        Your community, on a network <span class="text-primary">nobody owns.</span>
      </h1>

      <p class="rise rise-2 mx-auto mt-6 max-w-[36rem] text-lede text-body lg:mx-0">
        Spaces with chat, voice and video. Music you publish yourself. Messages that stay private.
        The Wired is a desktop app built on Nostr, so your identity and your people go wherever you go.
      </p>

      <div class="rise rise-3 mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#download" class="btn btn-primary w-full sm:w-auto" data-hero-cta>
          <span data-hero-cta-icon><Icon name="download" size={18} strokeWidth={2.4} /></span>
          <span data-hero-cta-label>Download The Wired</span>
        </a>
        <a href={GITHUB_URL} class="btn btn-ghost w-full sm:w-auto">
          <Icon name="github" size={17} />
          View source
        </a>
      </div>

      <p class="rise rise-4 mt-4 font-mono text-[0.78rem] text-muted" data-hero-meta>
        Free for macOS, Windows and Linux.
        <a href="#mobile" class="text-link">On your phone? Get soot.</a>
      </p>
    </div>

    <!-- character -->
    <div class="relative mx-auto w-full max-w-[30rem] lg:max-w-[34rem]">
      <div class="backlight inset-[12%] opacity-90" style="background: radial-gradient(circle at 50% 55%, #60706066, #78587044 45%, transparent 72%);" />
      <Picture
        src={heroGirl}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[360, 540, 760, 1024]}
        sizes="(min-width: 1024px) 34rem, (min-width: 640px) 30rem, 90vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="rise rise-2 relative w-full drop-shadow-[0_30px_60px_#000000aa]"
      />
      <!-- the ground she stands on fades into the page -->
      <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background to-transparent" />

      <ul class="pointer-events-none hidden sm:block" aria-label="Protocols">
        <li class="drift tag absolute left-[2%] top-[22%]"><span class="h-1.5 w-1.5 rounded-full bg-primary" />NIP-29 spaces</li>
        <li class="drift tag absolute right-[0%] top-[44%]" style="animation-delay:-2.5s"><span class="h-1.5 w-1.5 rounded-full bg-accent" />NIP-17 encrypted DMs</li>
        <li class="drift tag absolute bottom-[20%] left-[6%]" style="animation-delay:-4.5s"><span class="h-1.5 w-1.5 rounded-full bg-[#E8C27A]" />NIP-57 zaps</li>
      </ul>
    </div>
  </div>

  <!-- proof strip -->
  <div class="container mt-14 lg:mt-10">
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-border pt-6 font-mono text-[0.75rem] text-muted lg:justify-between">
      {proof.map((p) => (
        <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-full bg-faint" />{p}</li>
      ))}
    </ul>
  </div>
</section>
