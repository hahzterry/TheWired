---
import Icon from './Icon.astro';
import { GITHUB_URL, ISSUES_URL, RELAY_URL, RELEASES_URL, SOOT } from '../data/site';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { href: '#download', label: 'Download' },
      { href: '#inside', label: 'Inside the app' },
      { href: '#features', label: 'Features' },
      { href: RELEASES_URL, label: 'Release notes' },
    ],
  },
  {
    title: 'Mobile',
    links: [
      { href: SOOT.site, label: 'soot.win' },
      { href: SOOT.appStore, label: 'soot on the App Store' },
      { href: SOOT.googlePlay, label: 'soot on Google Play' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { href: GITHUB_URL, label: 'GitHub' },
      { href: ISSUES_URL, label: 'Report an issue' },
      { href: 'https://nostr.com/', label: 'What is Nostr?' },
      { href: 'https://github.com/nostr-protocol/nips', label: 'NIPs' },
      { href: RELAY_URL, label: 'Our relay' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/terms', label: 'Terms' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/community-guidelines', label: 'Community guidelines' },
      { href: '/support', label: 'Support' },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="container py-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_repeat(4,1fr)]">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-3">
          <img src="/logo-64.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" loading="lazy" />
          <span class="wordmark text-[0.95rem]">The Wired</span>
        </a>
        <p class="mt-5 text-sm text-muted">
          Spaces, music, calls and private messages on a network nobody owns. Built on Nostr.
        </p>
        <a href={GITHUB_URL} class="mt-5 inline-flex items-center gap-2 text-sm text-body hover:text-heading">
          <Icon name="github" size={16} /> ummilabs/TheWired
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-4 lg:col-span-4">
        {columns.map((c) => (
          <nav aria-label={c.title}>
            <h2 class="font-mono text-[0.72rem] font-medium uppercase tracking-[0.14em] text-accent">{c.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {c.links.map((l) => (
                <li><a href={l.href} class="text-sm text-body transition-colors hover:text-heading">{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-border pt-8 font-mono text-[0.75rem] text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} The Wired. Code under the MIT license.</p>
      <p class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-primary" aria-hidden="true" /> Built on Nostr
      </p>
    </div>
  </div>
</footer>
